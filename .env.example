# NovelAI API Key
# Get your API key from https://novelai.net/
NOVELAI_API_KEY=your-api-key-here

# Optional: default model (V5 Full by default)
# NOVELAI_MODEL=nai-diffusion-5-full

# Optional: force generation through mirror proxy
# true = all generations via api.mmw.ink
# false = V5 also uses official API directly
# default: V5 uses proxy, V4.5 uses official
# NOVELAI_USE_PROXY=true

# Optional: image save directory
# Default: %USERPROFILE%\Desktop\NovelAI_Output
# NOVELAI_SAVE_DIR=%USERPROFILE%\Desktop\NovelAI_Output

# HTTPS_PROXY="http://127.0.0.1:7890"